generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  email               String?    @unique
  role                String     @default("USER")
  addressApt          String?    @map("address_apt")
  addressFloor        String?    @map("address_floor")
  addressStreet       String?    @map("address_street")
  addressStreetNumber String?    @map("address_street_number")
  authProvider        String?    @map("auth_provider")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  emailVerified       Boolean    @default(false) @map("email_verified")
  firebaseUid         String?    @unique @map("firebase_uid")
  firstName           String?    @map("first_name")
  interestedIn        String?    @map("interested_in")
  isDelete            Boolean    @default(false) @map("is_delete")
  isNewsletter        Boolean    @default(false) @map("is_newsletter")
  language            String?
  lastName            String?    @map("last_name")
  phone               String?    @unique
  pointsBalance       Decimal    @default(0) @map("points_balance") @db.Decimal(10, 2)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  verifoneCustomerNo  String?    @map("verifone_customer_no")
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  phoneVerifiedAt     DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  signupCompletedAt   DateTime?  @map("signup_completed_at") @db.Timestamptz(6)
  birthday            DateTime   @db.Date
  addressCity         String?    @map("address_city")
  cartItems           CartItem[]
  favorites           Favorite[]
  orders              Order[]
  points              Points[]
  reviews             Review[]

  @@map("users")
}

model CartItem {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  cartKey   String         @map("cart_key")
  baseSku   String         @map("base_sku")
  colorSlug String?        @map("color_slug")
  sizeSlug  String?        @map("size_slug")
  quantity  Int
  unitPrice Decimal?       @map("unit_price") @db.Decimal(10, 2)
  status    CartItemStatus @default(IN_CART)
  orderId   String?        @map("order_id")
  removedAt DateTime?      @map("removed_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cartKey])
  @@index([userId, status])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("cart_items")
}

model Favorite {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  productBaseSku String    @map("product_base_sku")
  colorSlug      String    @default("") @map("color_slug")
  isActive       Boolean   @default(true) @map("is_active")
  favoritedAt    DateTime  @default(now()) @map("favorited_at") @db.Timestamptz(6)
  unfavoritedAt  DateTime? @map("unfavorited_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productBaseSku, colorSlug])
  @@index([userId, isActive])
  @@map("favorites")
}

model NewsletterEmails {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  @@map("newsletter_emails")
}

model Category {
  id          String     @id @default(cuid())
  description String?
  image       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  isEnabled   Boolean    @default(true)
  level       Int        @default(0)
  name_en     String     @unique
  name_he     String     @unique
  parentId    String?
  slug_en     String     @unique
  slug_he     String     @unique
  sortOrder   Int        @default(0)
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]  @relation("CategoryProducts")

  @@map("categories")
}

model BogoGroup {
  id           String    @id @default(cuid())
  name         String
  pairPriceIls Float
  products     Product[]

  @@map("bogo_groups")
}

model Product {
  id                   String                   @id @default(cuid())
  featured             Boolean                  @default(false)
  isNew                Boolean                  @default(false)
  isActive             Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  categoryId           String
  brand                String
  categories_path      String[]
  categories_path_id   String[]
  category             String
  currency             String                   @default("ILS")
  description_en       String
  description_he       String
  heelHeight_en        String?
  heelHeight_he        String?
  isDeleted            Boolean                  @default(false)
  isEnabled            Boolean                  @default(true)
  lining_en            String?
  lining_he            String?
  materialInnerSole_en String?
  materialInnerSole_he String?
  price                Float
  salePrice            Float?
  searchKeywords       String[]
  seo_description_en   String?
  seo_description_he   String?
  seo_slug             String?
  seo_title_en         String?
  seo_title_he         String?
  shippingReturns_en   String?
  shippingReturns_he   String?
  sku                  String                   @unique
  sole_en              String?
  sole_he              String?
  subCategory          String?
  subSubCategory       String?
  title_en             String
  title_he             String
  upperMaterial_en     String?
  upperMaterial_he     String?
  colorVariants        Json?                    @default("{}")
  // Basic information additions
  shortTitle_en        String?
  shortTitle_he        String?
  shortDescription_en  String?
  shortDescription_he  String?
  // Structured specification additions (existing material/lining/sole/dimension/heelHeight text fields above are reused as-is)
  toeShape_en          String?
  toeShape_he          String?
  pattern_en           String?
  pattern_he           String?
  finish_en            String?
  finish_he            String?
  closureType_en       String?
  closureType_he       String?
  heelType_en          String?
  heelType_he          String?
  careInstructions_en  String?
  careInstructions_he  String?
  // Dropdown-backed attribute fields (single stable value; labels resolved via
  // getOptionLabel in lib/product-enums.ts, never persisted). Bare names, distinct
  // from the legacy *_en/*_he pairs above, which remain as historical/reconciliation data.
  upperMaterial        String[]                 @default([])
  lining               String?
  insole               String?
  outsole              String?
  soleType             String?
  toeShape             String?
  heelType             String?
  closureType          String?
  heelHeight           String?
  // Shoe fit & sizing (only meaningful for footwear categories; see lib/product-enums.ts)
  sizeFit              String?
  footWidthFit         String?
  toeBoxFit            String?
  instepFit            String?
  archFit              String?
  adjustableFeatures   String[]                 @default([])
  fitRecommendation_en String?
  fitRecommendation_he String?
  fitNotes_en          String?
  fitNotes_he          String?
  // SEO focus/secondary keywords (seo_title_en/he, seo_description_en/he, seo_slug already existed above)
  seoFocusKeyword_en   String?
  seoFocusKeyword_he   String?
  seoSecondaryKeywords_en String[]              @default([])
  seoSecondaryKeywords_he String[]              @default([])
  category_he          String?
  subCategory_he       String?
  subSubCategory_he    String?
  colors_search_norm   String                   @default("")
  generated_search_keywords String[]            @default([])
  title_search_norm    String?                  @ignore
  category_search_norm String?                  @ignore
  sku_search_norm      String?                  @ignore
  description_search_norm String?               @ignore
  search_blob_norm     String?                  @ignore
  search_vector        Unsupported("tsvector")?
  tags                 String[]                 @default([])
  categoryRelation     Category                 @relation("CategoryProducts", fields: [categoryId], references: [id], onDelete: Cascade)
  bogoGroupId          String?
  bogoGroup            BogoGroup?               @relation(fields: [bogoGroupId], references: [id])
  productTags          ProductTag[]

  @@map("products")
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  products  ProductTag[]

  @@map("tags")
}

model ProductTag {
  id        String  @id @default(cuid())
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@map("product_tags")
}

model Order {
  id                         String        @id @default(cuid())
  orderNumber                String        @unique
  status                     String        @default("pending")
  total                      Float
  /// Shipping method for the order: "delivery" or "pickup"
  shippingMethod             String        @default("delivery")
  /// Pickup location for self-pickup orders (e.g. store address)
  pickupLocation             String?
  currency                   String        @default("ILS")
  customerName               String?
  customerEmail              String?
  customerPhone              String?
  paymentStatus              String        @default("pending")
  paymentMethod              String?
  paymentData                String?
  cardcomLowProfileId        String?
  cardcomTransactionId       String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  emailMessageId             String?
  emailSentAt                DateTime?
  smsSentAt                  DateTime?
  smsMessageId               String?
  subtotal                   Float?
  discountTotal              Float         @default(0)
  deliveryFee                Float         @default(0)
  bogoDiscountAmount         Float?
  userId                     String?       @map("user_id") @db.Uuid
  appliedCoupons             OrderCoupon[]
  orderItems                 OrderItem[]
  user                       User?         @relation(fields: [userId], references: [id])
  payments                   Payment[]
  points                     Points[]
  verifoneInvoiceStatus      String?       @map("verifone_invoice_status")
  verifoneInvoiceNo          String?       @map("verifone_invoice_no")
  verifoneInvoiceRequest     String?       @map("verifone_invoice_request")
  verifoneInvoiceResponse    String?       @map("verifone_invoice_response")
  verifoneInvoiceAttemptedAt DateTime?     @map("verifone_invoice_attempted_at")
  verifoneInvoiceSyncedAt    DateTime?     @map("verifone_invoice_synced_at")
  verifoneInvoiceError       String?       @map("verifone_invoice_error")
  /// "Last updated" ISO date of the /terms page (staticPages/terms) at the moment
  /// the customer accepted it, captured server-side — not client-supplied.
  termsAcceptedVersion       String?       @map("terms_accepted_version")
  /// When the customer accepted the Terms & Conditions during checkout.
  termsAcceptedAt            DateTime?     @map("terms_accepted_at")
  /// Carrier shipments for this order (HFD today, other providers later).
  shipments                  Shipment[]
  /// The post-delivery review request, if one has been scheduled.
  reviewRequest              ReviewRequest?
  /// The customer's submitted review, if they completed one.
  review                     Review?

  @@index([userId])
  @@map("orders")
}

model VerifoneManualInvoiceAudit {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  adminEmail       String   @map("admin_email")
  orderNumber      String?  @map("order_number")

  requestJson      Json     @map("request_json")

  responseXml      String?  @map("response_xml")
  responseParsed   Json?    @map("response_parsed")
  httpStatus       Int?     @map("http_status")
  errorMessage     String?  @map("error_message")

  @@index([orderNumber])
  @@index([createdAt(sort: Desc)])
  @@map("verifone_manual_invoice_audits")
}

/// A parcel handed to a shipping carrier. Provider-agnostic on purpose: `provider`
/// discriminates the carrier ("hfd" today) so a second courier needs no schema change.
model Shipment {
  id                    String    @id @default(cuid())
  orderId               String    @map("order_id")
  /// Denormalized copy of Order.orderNumber — carriers reference us by this value,
  /// so keeping it here avoids a join on every webhook lookup.
  orderNumber           String    @map("order_number")
  provider              String    @default("hfd")
  /// The carrier's own shipment id (HFD `ship_no`). NOT NULL by design: Postgres
  /// treats NULLs as distinct in a unique index, so a nullable column here would
  /// silently permit duplicate shipments whenever the carrier omits the field.
  /// When it is genuinely absent the normalizer substitutes `order:<orderNumber>`.
  providerShipmentNo    String    @map("provider_shipment_no")
  /// The reference value we actually matched the order on (HFD `ref2`).
  providerRef           String?   @map("provider_ref")
  providerRandomId      String?   @map("provider_random_id")
  /// True only for a successful delivery to the customer. A parcel returned to
  /// sender is NOT recorded here — see isReturnedToSender.
  isDelivered           Boolean   @default(false) @map("is_delivered")
  /// HFD `ship_delivered_back_yn`: the parcel came back to us. It arrives together
  /// with ship_delivered_yn="y", so it must gate the delivery transition.
  isReturnedToSender    Boolean   @default(false) @map("is_returned_to_sender")
  isCanceled            Boolean   @default(false) @map("is_canceled")
  deliveredAt           DateTime? @map("delivered_at")
  returnedAt            DateTime? @map("returned_at")
  canceledAt            DateTime? @map("canceled_at")
  lastStatusCode        String?   @map("last_status_code")
  lastStatusDesc        String?   @map("last_status_desc")
  lastStatusAt          DateTime? @map("last_status_at")
  lastWebhookReceivedAt DateTime? @map("last_webhook_received_at")
  /// Most recent raw carrier payload, kept for debugging an undocumented format.
  rawLatestPayload      Json?     @map("raw_latest_payload")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events ShipmentEvent[]

  /// Idempotency key for webhook redelivery: the same parcel always upserts one row.
  @@unique([provider, providerShipmentNo])
  @@index([orderId])
  @@index([orderNumber])
  @@index([isDelivered, deliveredAt])
  @@map("shipments")
}

/// One carrier status transition. Append-only history behind Shipment's latest-state columns.
model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String   @map("shipment_id")
  statusCode String   @map("status_code")
  statusDesc String?  @map("status_desc")
  /// Always set — the normalizer falls back to webhook receipt time when the
  /// carrier's date/time fields are missing or unparseable.
  occurredAt DateTime @map("occurred_at")
  location   String?
  city       String?
  raw        Json?
  createdAt  DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  /// Dedupes redelivered webhooks: replaying the same payload inserts nothing.
  @@unique([shipmentId, statusCode, occurredAt])
  @@index([shipmentId, occurredAt(sort: Desc)])
  @@map("shipment_events")
}

/// Raw inbound webhook log. Deliberately has NO foreign key to orders: its whole
/// purpose is to survive the cases where no order matched, or the body did not parse.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  receivedAt  DateTime @default(now()) @map("received_at")
  /// verified | unauthenticated | rejected
  authOutcome String   @map("auth_outcome")
  /// processed | ignored | invalid | unknown_order | error
  status      String
  orderNumber String?  @map("order_number")
  payload     Json
  /// Request headers with credential values redacted to a fingerprint. Lets us
  /// discover which auth mechanism the carrier actually uses from real traffic,
  /// without writing their secret into our database.
  headers     Json?
  error       String?

  @@index([provider, receivedAt(sort: Desc)])
  @@index([orderNumber])
  @@index([status])
  @@map("webhook_events")
}

/// A scheduled post-delivery review request. `orderId` is unique — that constraint
/// IS the guarantee a review is never scheduled twice for the same order.
model ReviewRequest {
  id            String    @id @default(cuid())
  orderId       String    @unique @map("order_id")
  orderNumber   String    @map("order_number")
  /// pending | processing | sent | failed | skipped
  status        String    @default("pending")
  scheduledFor  DateTime  @map("scheduled_for")
  attempts      Int       @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at")
  nextAttemptAt DateTime? @map("next_attempt_at")
  sentAt        DateTime? @map("sent_at")
  /// Per-channel attempt results, e.g. { "email": { ok: true, messageId } }.
  channels      Json?
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@map("review_requests")
}

/// A customer's review of one order. `orderId` is unique — one review per order,
/// which is also what stops a leaked review link being used to spam submissions.
model Review {
  id              String   @id @default(cuid())
  orderId         String   @unique @map("order_id")
  orderNumber     String   @map("order_number")
  /// Null for guest checkouts, which have no user account.
  userId          String?  @map("user_id") @db.Uuid
  /// Overall shopping-experience rating, 1-5. The only required rating.
  overallRating   Int      @map("overall_rating")
  /// Optional 1-5 ratings. Nullable because the customer may skip them —
  /// requiring them would cost completions for feedback that is nice to have.
  serviceRating   Int?     @map("service_rating")
  deliveryRating  Int?     @map("delivery_rating")
  /// How the products themselves arrived — packaging and condition on delivery,
  /// as distinct from the courier's speed and handling (deliveryRating).
  packagingRating Int?     @map("packaging_rating")
  serviceComment  String?  @map("service_comment")
  deliveryComment String?  @map("delivery_comment")
  /// Free-text notes on packaging and the condition on arrival, paired with
  /// packagingRating.
  packagingComment String? @map("packaging_comment")
  /// Catch-all: anything the customer wants to tell us that the specific
  /// questions above did not cover.
  generalComment   String? @map("general_comment")
  /// Language the review was submitted in ("he" | "en").
  language        String   @default("he")
  submittedAt     DateTime @default(now()) @map("submitted_at")

  /// --- Manual loyalty-points follow-up -------------------------------------
  /// Points for reviewing are credited by hand in Verifone, so the system cannot
  /// know it happened. These columns are the record of that manual step, which is
  /// what makes "who still needs paying?" answerable.
  pointsAwardedAt DateTime? @map("points_awarded_at")
  /// Balance before and after the manual credit, as typed by the admin. Stored so
  /// the customer notification can state the actual change, and so the figures
  /// remain auditable after the fact.
  pointsBefore    Decimal?  @map("points_before") @db.Decimal(10, 2)
  pointsAfter     Decimal?  @map("points_after") @db.Decimal(10, 2)
  /// Email of the admin who recorded the award.
  pointsAwardedBy String?   @map("points_awarded_by")
  /// When the customer was told their points changed, and how it went.
  notifiedAt      DateTime? @map("notified_at")
  notifyResult    Json?     @map("notify_result")

  /// --- Review reward state machine -----------------------------------------
  /// pending | credited | not_eligible | failed
  ///
  /// Defaults to not_eligible: most orders are guest checkouts, so "no account to
  /// credit" is the common case rather than an error. It becomes `pending` only
  /// when the reviewer resolves to a registered account at submission time.
  rewardStatus        String    @default("not_eligible") @map("reward_status")
  /// Points owed for this review, snapshotted at submission. Stored rather than
  /// read from config at payout time so that changing the reward amount later
  /// cannot retroactively alter what a customer was already promised.
  rewardPoints        Int?      @map("reward_points")
  /// Set once the credit is confirmed. Combined with the unique orderId below,
  /// this is what makes a review rewardable at most once, ever.
  rewardCreditedAt    DateTime? @map("reward_credited_at")
  /// Reference for the credit (admin email today; a Verifone transaction id if
  /// they ever expose a points-write API), for audit.
  rewardTransactionId String?   @map("reward_transaction_id")
  rewardError         String?   @map("reward_error")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id])
  productReviews ProductReview[]

  @@index([orderNumber])
  @@index([submittedAt(sort: Desc)])
  /// Drives the admin's "still owed points" queue.
  @@index([pointsAwardedAt])
  @@index([rewardStatus])
  @@map("reviews")
}

/// Per-product feedback within a review, one row per reviewed order item.
model ProductReview {
  id          String   @id @default(cuid())
  reviewId    String   @map("review_id")
  /// Ties the rating to the exact purchased line (size/colour included).
  orderItemId String   @map("order_item_id")
  /// Denormalized so product-level aggregates never need to join order_items.
  productSku  String   @map("product_sku")
  rating      Int
  /// No longer collected — the form asks only for a rating, fit and free text.
  /// Kept nullable rather than dropped so the change is reversible without a
  /// destructive migration; nothing writes to it.
  title       String?
  body        String?
  /// "runs_small" | "true_to_size" | "runs_large"
  sizingFit   String?  @map("sizing_fit")
  photoUrl    String?  @map("photo_url")
  /// Reviews are held for moderation rather than published on submission.
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /// One rating per purchased line per review.
  @@unique([reviewId, orderItemId])
  @@index([productSku, isPublished])
  @@map("product_reviews")
}

model OrderItem {
  id           String   @id @default(cuid())
  quantity     Int
  price        Float
  total        Float
  productName  String
  productSku   String
  colorName    String?
  size         String?
  primaryImage String?
  salePrice    Float?
  modelNumber  String?
  createdAt    DateTime @default(now())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Per-product review of this purchased line, if the customer rated it.
  productReviews ProductReview[]

  @@map("order_items")
}

model Payment {
  id                   String   @id @default(cuid())
  amount               Float
  currency             String   @default("ILS")
  status               String   @default("pending")
  cardcomLowProfileId  String?
  cardcomTransactionId String?
  cardcomResponseCode  Int?
  cardcomDescription   String?
  paymentMethod        String?
  last4Digits          String?
  cardBrand            String?
  tokenId              String?
  tokenExpiry          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  orderId              String
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PaymentToken {
  id            String   @id @default(cuid())
  token         String   @unique
  last4Digits   String?
  cardBrand     String?
  cardExpiry    String?
  isActive      Boolean  @default(true)
  customerEmail String?
  customerName  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payment_tokens")
}

model Checkout {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  customerEmail         String
  customerFirstName     String
  customerLastName      String
  customerPhone         String
  customerStreetName    String
  customerStreetNumber  String
  customerFloor         String?
  customerApartment     String?
  customerCity          String
  customerState         String
  customerZip           String?
  customerCountry       String
  customerID            String?
  customerDeliveryNotes String?
  /// Shipping method selected at checkout: "delivery" or "pickup"
  shippingMethod        String   @default("delivery")
  /// Pickup location for self-pickup checkouts (e.g. store address)
  pickupLocation        String?

  @@map("checkouts")
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model Coupon {
  id                 String             @id @default(cuid())
  code               String             @unique
  name_en            String
  name_he            String
  description_en     String?
  description_he     String?
  discountType       CouponDiscountType
  discountValue      Float?
  minCartValue       Float?             @default(0)
  startDate          DateTime?
  endDate            DateTime?
  usageLimit         Int?
  usageLimitPerUser  Int?
  usageCount         Int                @default(0)
  stackable          Boolean            @default(false)
  autoApply          Boolean            @default(false)
  eligibleProducts   String[]           @default([])
  eligibleCategories String[]           @default([])
  bogoBuyQuantity    Int                @default(1)
  bogoGetQuantity    Int                @default(1)
  bogoEligibleSkus   String[]           @default([])
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  bogoBuySkus        String[]           @default([])
  bogoGetSkus        String[]           @default([])
  redemptions        CouponRedemption[]
  orderCoupons       OrderCoupon[]

  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  userIdentifier String
  usageCount     Int      @default(0)
  lastUsedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, userIdentifier])
  @@map("coupon_redemptions")
}

model OrderCoupon {
  id             String             @id @default(cuid())
  orderId        String
  couponId       String?
  code           String
  discountAmount Float
  discountType   CouponDiscountType
  stackable      Boolean
  description    String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  coupon         Coupon?            @relation(fields: [couponId], references: [id])
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([code])
  @@map("order_coupons")
}

model Points {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  orderId   String?    @map("order_id")
  kind      PointsKind
  delta     Decimal    @db.Decimal(10, 2)
  reason    String
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind])
  @@index([userId, createdAt])
  @@map("points")
}

enum CartItemStatus {
  IN_CART
  REMOVED
  CHECKED_OUT
  PURCHASED
}

enum CouponDiscountType {
  percent_all
  percent_specific
  fixed
  bogo
}

enum PointsKind {
  EARN
  SPEND
}
